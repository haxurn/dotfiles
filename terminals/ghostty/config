# ghostty (linked dir: ~/.config/ghostty). File must be named `config`.
theme = alacritty-default
font-family = JetBrainsMono Nerd Font Mono
font-size = 12
# Draw Nerd Font icons (Private Use Areas) from the non-Mono face so they keep
# full size: the Mono face squeezes every icon into one cell. Ghostty widens an
# icon to two cells only when a space follows it, so text grids stay aligned.
# Regular text stays Mono, so TUI alignment is untouched.
font-codepoint-map = U+E000-U+F8FF=JetBrainsMono Nerd Font
font-codepoint-map = U+F0000-U+FFFFD=JetBrainsMono Nerd Font

cursor-style = block
cursor-style-blink = true
window-padding-x = 8
window-padding-y = 8
scrollback-limit = 10000000

shell-integration = zsh
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true

# macOS (ignored on Linux)
macos-option-as-alt = true
macos-titlebar-style = tabs

keybind = ctrl+shift+r=reload_config
