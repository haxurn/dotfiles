# ghostty (linked dir: ~/.config/ghostty). File must be named `config`.
theme = alacritty-default
font-family = JetBrainsMono Nerd Font Mono
font-size = 12
# Render the Apple logo (U+F302) from the non-Mono face so it keeps its full
# advance width instead of being squeezed into one cell. Everything else stays
# Mono, so TUI alignment is untouched.
font-codepoint-map = U+F302=JetBrainsMono Nerd Font

cursor-style = block
cursor-style-blink = true
window-padding-x = 8
window-padding-y = 8
scrollback-limit = 10000000

shell-integration = zsh
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true

# macOS (ignored on Linux)
macos-option-as-alt = true
macos-titlebar-style = tabs

keybind = ctrl+shift+r=reload_config
